# Copy to .env and fill in. Never commit .env.

# Encrypts the credentials stored in n8n. Generate once and keep it:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
N8N_ENCRYPTION_KEY=

# Port for the n8n editor, form and API (http://localhost:5678)
N8N_PORT=5678
TIMEZONE=America/Phoenix

# Optional: a Figma personal access token (Figma > Settings > Security > Personal access tokens,
# scope "File content: read-only"). Only needed for Figma links; uploaded images work without it.
FIGMA_TOKEN=

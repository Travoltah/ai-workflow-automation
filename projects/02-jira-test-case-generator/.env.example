# Copy to .env and fill in. Never commit .env.

# PostgreSQL (used by n8n itself and for the qa_testgen test library)
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Encrypts the credentials (API keys, Jira token) n8n stores. Generate once and keep it safe:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
N8N_ENCRYPTION_KEY=change-me

# Port for the n8n editor. Change it if you already run another n8n on 5678.
N8N_PORT=5678
TIMEZONE=America/Phoenix

# API keys are NOT read from here: add them in n8n under Credentials (see README, step 3).

        "options": {}
      },
      "id": "80850e37-9e2f-5c19-90a4-1231e745c8c3",
      "name": "OpenAI Embeddings",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "position": [
        880,
        220

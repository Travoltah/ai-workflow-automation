    },
    {
      "parameters": {
        "jsCode": "// One summary item for the form's completion screen and the execution log.\nconst files = $('Prepare files').all().map((i) => i.json.source);\nreturn [{ json: {\n  filesIndexed: files.length,\n  chunksStored: $input.all().length,\n  files,\n  collection: 'faq_knowledge_base',\n  finishedAt: new Date().toISOString(),\n} }];\n"
      },
      "id": "c1bc0aa6-3f57-503f-9d4c-2b39b0bfba75",
      "name": "Ingestion summary",
